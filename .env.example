# ── APEX-SCALP configuration ──────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit your real .env.

# Trading mode. Keep PAPER until you have validated with backtest + forward test.
# Allowed: paper | live
APEX_MODE=paper

# ── MetaTrader 5 connection (only used when APEX_MODE=live) ────────────────
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=ICMarkets-Demo
# Windows path to the terminal, e.g. C:/Program Files/MetaTrader 5/terminal64.exe
MT5_PATH=

# ── Risk parameters (percent of capital) ──────────────────────────────────
APEX_RISK_PER_TRADE_PCT=0.5
APEX_MAX_DAILY_RISK_PCT=2.0
APEX_MAX_WEEKLY_RISK_PCT=5.0
APEX_MAX_OPEN_POSITIONS=3

# Starting balance for the paper broker simulation
APEX_PAPER_BALANCE=10000

# ── Engine ─────────────────────────────────────────────────────────────────
# Comma-separated symbols to scan
APEX_SYMBOLS=EURUSD,GBPUSD,USDJPY,XAUUSD,NAS100
# Entry score threshold (0-10) and minimum number of aligned strategies
APEX_ENTRY_SCORE=7.0
APEX_MIN_ALIGNED=3
# Bot magic number (unique id used on MT5 orders)
APEX_MAGIC=20240101

# ── Dashboard ───────────────────────────────────────────────────────────────
APEX_DASHBOARD_HOST=127.0.0.1
APEX_DASHBOARD_PORT=8050

# ── Optional Telegram alerts ─────────────────────────────────────────────────
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
